# Copy to config/local.env and fill your keys
AMAP_KEY=
AMAP_SECURITY_JS_CODE=
REMOTION_AMAP_KEY=
REMOTION_AMAP_SECURITY_CODE=
AMAP_ROUTE_PORT=6137

# Storage defaults to local files in output/, even if Supabase keys are present.
# Running this repo as a website? Set this to cloud (with SUPABASE_* below).
# ROADTRIP_STORAGE=cloud
# ROADTRIP_OUTPUT_ROOT=

# Multi-user deployment (ROADTRIP_STORAGE=cloud)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Hillshade (URL template must contain {z}, {x}, {y})
HILLSHADE_ENABLED=true
HILLSHADE_SOURCE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}
HILLSHADE_CACHE_VERSION=v2
HILLSHADE_MIN_ZOOM=5
HILLSHADE_MAX_ZOOM=12

# Point info
POINT_INFO_WEATHER_PROVIDER=openmeteo
POINT_INFO_ELEVATION_PROVIDER=openmeteo
POINT_INFO_WEATHER_TTL_MINUTES=30

# Local mode needs nothing else: requests from this machine are the local user,
# and no account, email or database is involved.
#
# Serving locally-stored routes to other machines (single-user site, no auth proxy)?
# Uncomment the line below. Every client then shares this machine's output/ folder.
# ROADTRIP_SINGLE_USER=true

# Multi-user deployment: an auth proxy injects X-Auth-Request-Email.
# Trust that header only from these proxy addresses (comma separated IP/CIDR).
# ROADTRIP_TRUSTED_PROXY_IPS=10.0.0.0/8
# Optional shared secret, also sent by the proxy as X-Roadtrip-Proxy-Secret.
# ROADTRIP_PROXY_SECRET=
# ROADTRIP_TRUST_PROXY_ANY=false
