[Unit]
Description=RoadTripPlanner map service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=me
Group=me
WorkingDirectory=/opt/RoadTripPlanner/app
EnvironmentFile=/etc/roadplan/map.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/RoadTripPlanner/data

[Install]
WantedBy=multi-user.target
